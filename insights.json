    "Query 6: CTE - Academic Scores Comparison (Placed vs Unplaced)": {
        "sql": "WITH AcademicAverages AS (\n    SELECT \n        status,\n        COUNT(*) AS student_count,\n        ROUND(AVG(ssc_p), 2) AS avg_ssc_p,\n        ROUND(AVG(hsc_p), 2) AS avg_hsc_p,\n        ROUND(AVG(degree_p), 2) AS avg_degree_p,\n        ROUND(AVG(mba_p), 2) AS avg_mba_p,\n        ROUND(AVG(etest_p), 2) AS avg_etest_p\n    FROM students\n    GROUP BY status\n)\nSELECT \n    status,\n    student_count,\n    avg_ssc_p,\n    avg_hsc_p,\n    avg_degree_p,\n    avg_mba_p,\n    avg_etest_p\nFROM AcademicAverages;",
        "row_count": 2,
        "data": [
            {
                "status": "Not Placed",
                "student_count": 67,
                "avg_ssc_p": 57.54,
                "avg_hsc_p": 58.4,
                "avg_degree_p": 61.13,
                "avg_mba_p": 61.61,
                "avg_etest_p": 69.59
            },
            {
                "status": "Placed",
                "student_count": 148,
                "avg_ssc_p": 71.72,
                "avg_hsc_p": 69.93,
                "avg_degree_p": 68.74,
                "avg_mba_p": 62.58,
                "avg_etest_p": 73.24
            }
        ]
    },
