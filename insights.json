    "Query 6: CTE - Academic Scores Comparison (Placed vs Unplaced)": {
        "sql": "WITH AcademicAverages AS (\n    SELECT \n        status,\n        COUNT(*) AS student_count,\n        ROUND(AVG(ssc_p), 2) AS avg_ssc_p,\n        ROUND(AVG(hsc_p), 2) AS avg_hsc_p,\n        ROUND(AVG(degree_p), 2) AS avg_degree_p,\n        ROUND(AVG(mba_p), 2) AS avg_final_p,\n        ROUND(AVG(etest_p), 2) AS avg_etest_p\n    FROM students\n    GROUP BY status\n)\nSELECT \n    status,\n    student_count,\n    avg_ssc_p,\n    avg_hsc_p,\n    avg_degree_p,\n    avg_final_p,\n    avg_etest_p\nFROM AcademicAverages;",
        "row_count": 2,
        "data": [
            {
                "status": "Not Placed",
                "student_count": 308,
                "avg_ssc_p": 67.82,
                "avg_hsc_p": 66.59,
                "avg_degree_p": 65.37,
                "avg_final_p": 64.89,
                "avg_etest_p": 67.29
            },
            {
                "status": "Placed",
                "student_count": 167,
                "avg_ssc_p": 71.45,
                "avg_hsc_p": 69.36,
                "avg_degree_p": 68.0,
                "avg_final_p": 65.06,
                "avg_etest_p": 71.26
            }
        ]
    },
