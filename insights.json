    "Query 1: Overall Placement Overview across All Degree Programs": {
        "sql": "SELECT \n    COUNT(*) AS total_students,\n    SUM(Placed_Flag) AS total_placed,\n    COUNT(*) - SUM(Placed_Flag) AS total_unplaced,\n    ROUND(AVG(Placed_Flag) * 100, 2) AS placement_rate_pct\nFROM students;",
        "row_count": 1,
        "data": [
            {
                "total_students": 475,
                "total_placed": 167,
                "total_unplaced": 308,
                "placement_rate_pct": 35.16
            }
        ]
    },
